DJANGO_SECRET_KEY=devkey-change-me
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# --- DATABASE CONNECTION ---
# Cấu trúc: postgres://<user>:<password>@<host>:<port>
# Lưu ý:
# 1. User/Pass: dùng 'app_user' và 'app_password' (đã tạo trong 01-init.sql)
# 2. Host: dùng 'db' (tên service trong docker-compose.yml)
# 3. DB Name: dùng 'final' (DB chung của hệ thống)
DATABASE_URL=postgres://app_user:app_password@db:5432/final

SERVICE_NAME=project-service

# Nếu sau này Project Service cần gọi sang User Service (ví dụ lấy avatar)
# USER_SERVICE_URL=http://user-service:8000